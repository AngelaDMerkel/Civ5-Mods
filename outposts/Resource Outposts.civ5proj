<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0" DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{4547AE42-3D17-4993-99E8-A7A5A2C1EC2C}</ProjectGuid>
    <ModGuid>4547ae42-3d17-4993-99e8-a7a5a2c1ec2c</ModGuid>
    <ModVersion>1</ModVersion>
    <RootNamespace>ResourceOutposts</RootNamespace>
    <AssemblyName>Resource Outposts</AssemblyName>
    <Name>Resource Outposts</Name>
    <Stability>Alpha</Stability>
    <Teaser>Secure remote resources with independent, defended outposts.</Teaser>
    <Description>Independent worker-built outposts claim neutral strategic and luxury deposits. Includes an outpost overview, upkeep, abandonment previews, territorial conversion, resource notifications and AI expeditions with escorts, recovery and stalled-order handling. No roads or supply connections required. Optional Realistic Terrain integration adds garrison shelter only. Requires Brave New World. Single-player alpha; start a new game.</Description>
    <Authors>Duffy</Authors>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>1</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>0</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <SupportsLeaderboards>0</SupportsLeaderboards>
    <ReloadLandmarkSystem>1</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
    <Dependencies>&lt;Dependencies&gt;
    &lt;Dlc id="6DA07636-4123-4018-B643-6575B4EC336B" minversion="0" maxversion="999" /&gt;
  &lt;/Dependencies&gt;
  </Dependencies>
    <References>&lt;References&gt;
    &lt;Mod id="d571e16c-bb58-40bf-a81f-a919249e7995" minversion="2" maxversion="999" title="Realistic Terrain" /&gt;
  &lt;/References&gt;
  </References>
    <Blocks>&lt;Blocks&gt;
    &lt;Mod id="d571e16c-bb58-40bf-a81f-a919249e7995" minversion="0" maxversion="1" title="Realistic Terrain (old bundled outposts)" /&gt;
  &lt;/Blocks&gt;
  </Blocks>
    <Actions>&lt;Actions&gt;
    &lt;OnModActivated&gt;
      &lt;UpdateDatabase&gt;Text/RO_Text.xml&lt;/UpdateDatabase&gt;
      &lt;UpdateDatabase&gt;SQL/RO_Outposts.sql&lt;/UpdateDatabase&gt;
    &lt;/OnModActivated&gt;
  &lt;/Actions&gt;
  </Actions>
    <EntryPoints>&lt;EntryPoints&gt;
    &lt;EntryPoint type="InGameUIAddin" file="UI/RO_UI.xml"&gt;
      &lt;Name&gt;Resource Outposts&lt;/Name&gt;
      &lt;Description&gt;Independent worker-built outposts claim neutral strategic and luxury deposits. Includes an outpost overview, upkeep, abandonment previews, territorial conversion, resource notifications and AI expeditions with escorts, recovery and stalled-order handling. No roads or supply connections required. Optional Realistic Terrain integration adds garrison shelter only. Requires Brave New World. Single-player alpha; start a new game.&lt;/Description&gt;
    &lt;/EntryPoint&gt;
  &lt;/EntryPoints&gt;
</EntryPoints>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Lua\RO_AI.lua">
      <ImportIntoVFS>True</ImportIntoVFS>
    </Content>
    <Content Include="Lua\RO_Integration.lua">
      <ImportIntoVFS>True</ImportIntoVFS>
    </Content>
    <Content Include="Lua\RO_Management.lua">
      <ImportIntoVFS>True</ImportIntoVFS>
    </Content>
    <Content Include="Lua\RO_Orders.lua">
      <ImportIntoVFS>True</ImportIntoVFS>
    </Content>
    <Content Include="Lua\RO_Outposts.lua">
      <ImportIntoVFS>True</ImportIntoVFS>
    </Content>
    <Content Include="Lua\RO_Serialize.lua">
      <ImportIntoVFS>True</ImportIntoVFS>
    </Content>
    <Content Include="SQL\RO_Outposts.sql">
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
    <Content Include="Text\RO_Text.xml">
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
    <Content Include="UI\RO_UI.lua">
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
    <Content Include="UI\RO_UI.xml">
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Firaxis\ModBuddy\Civ5Mod.targets" />
</Project>