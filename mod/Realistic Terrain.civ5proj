<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0" DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{D571E16C-BB58-40BF-A81F-A919249E7995}</ProjectGuid>
    <ModGuid>d571e16c-bb58-40bf-a81f-a919249e7995</ModGuid>
    <ModVersion>2</ModVersion>
    <RootNamespace>RealisticTerrain</RootNamespace>
    <AssemblyName>Realistic Terrain</AssemblyName>
    <Name>Realistic Terrain</Name>
    <Stability>Alpha</Stability>
    <Teaser>Prepare expeditions beyond your borders.</Teaser>
    <Description>Environmental exposure, cooperative trade logistics and connected desert irrigation. Build Irrigation Works, irrigated farms, the Ministry of Coin, road-connected Caravansaries and patrols. Optional Resource Outposts integration shelters its stationed defenders. Requires Brave New World. Single-player alpha; start a new game.</Description>
    <Authors>Duffy</Authors>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>2</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
    <SupportsHotSeat>0</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <SupportsLeaderboards>0</SupportsLeaderboards>
    <ReloadLandmarkSystem>1</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
    <Dependencies>&lt;Dependencies&gt;
    &lt;Dlc id="6DA07636-4123-4018-B643-6575B4EC336B" minversion="0" maxversion="999" /&gt;
  &lt;/Dependencies&gt;
  </Dependencies>
    <References>&lt;References /&gt;
  </References>
    <Blocks>&lt;Blocks /&gt;
  </Blocks>
    <Actions>&lt;Actions&gt;
    &lt;OnModActivated&gt;
      &lt;UpdateDatabase&gt;Text/RT_Text.xml&lt;/UpdateDatabase&gt;
      &lt;UpdateDatabase&gt;SQL/RT_Promotions.sql&lt;/UpdateDatabase&gt;
      &lt;UpdateDatabase&gt;SQL/RT_ReliefStation.sql&lt;/UpdateDatabase&gt;
      &lt;UpdateDatabase&gt;SQL/RT_MinistryOfCoin.sql&lt;/UpdateDatabase&gt;
      &lt;UpdateDatabase&gt;SQL/RT_Trade.sql&lt;/UpdateDatabase&gt;
      &lt;UpdateDatabase&gt;SQL/RT_MotorizedCaravan.sql&lt;/UpdateDatabase&gt;
      &lt;UpdateDatabase&gt;SQL/RT_Irrigation.sql&lt;/UpdateDatabase&gt;
      &lt;UpdateDatabase&gt;SQL/RT_Art.sql&lt;/UpdateDatabase&gt;
    &lt;/OnModActivated&gt;
  &lt;/Actions&gt;
  </Actions>
    <EntryPoints>&lt;EntryPoints&gt;
    &lt;EntryPoint type="InGameUIAddin" file="UI/RT_Environment.xml"&gt;
      &lt;Name&gt;Realistic Terrain&lt;/Name&gt;
      &lt;Description&gt;Environmental exposure, cooperative trade logistics and connected desert irrigation. Build Irrigation Works, irrigated farms, the Ministry of Coin, road-connected Caravansaries and patrols. Optional Resource Outposts integration shelters its stationed defenders. Requires Brave New World. Single-player alpha; start a new game.&lt;/Description&gt;
    &lt;/EntryPoint&gt;
  &lt;/EntryPoints&gt;
</EntryPoints>
  </PropertyGroup>
